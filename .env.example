# Copia este archivo a .env y llena los valores reales.
# El .env NUNCA se commitea: está en .gitignore.
#
# Genera los secretos con:
#   openssl rand -base64 32   (contraseñas y claves)
#   openssl rand -hex 32      (tokens y firmas)

# --- Dominio y TLS ---
DOMINIO=tudominio.com
EMAIL_TLS=tu@correo.com

# --- Postgres ---
POSTGRES_USER=leads_app
POSTGRES_PASSWORD=cambiar_openssl_rand_base64_32
POSTGRES_DB=leads

# --- API ---
JWT_SECRET=cambiar_openssl_rand_hex_32
# Token de servicio para POST /pipeline/run. El mismo valor se pega en la
# credencial Header Auth "X-Pipeline-Token" dentro de n8n.
PIPELINE_TOKEN=cambiar_openssl_rand_hex_32

# --- Usuarios de demo (los siembra `python -m backend.cli seed-usuarios`) ---
# Nunca pongas estas contraseñas en un .sql commiteado.
SEED_PASSWORD_ASESOR=cambiar
SEED_PASSWORD_GERENTE=cambiar

# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_CONCURRENCIA=8

# --- Score y colas ---
# En cuántos días se absorbe el represamiento de clientes sin primer contacto.
# Capacidad diaria de primer contacto = pendientes / días; el resto va a seguimiento.
DIAS_ABSORBER_REPRESAMIENTO=2

# --- Fecha de referencia ---
# Desde qué fecha se cuentan las horas sin contacto (urgencia y desempate) y
# hasta dónde llega la ventana de fechas válidas. Por defecto se calcula desde
# el dataset, que es un corte estático (2026-09-14). En operación real sería la
# fecha de ejecución. Nunca se usa la fecha del sistema. Formato yyyy-mm-dd.
# FECHA_REFERENCIA=2026-09-14

# --- n8n ---
# Si cambias esta clave pierdes todas las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=cambiar_openssl_rand_base64_32

# --- Rutas ---
DATA_INPUT_DIR=/app/data/input
