# Caddy saca y renueva el certificado de Let's Encrypt solo.
# No hay que tocar certbot ni rutas de certificados.
#
# Cloudflare va con el proxy activado (nube naranja) y SSL/TLS en
# "Full (strict)": Cloudflare valida este certificado al hablar con el VPS.
# El primer certificado se emite con la nube gris (DNS only); con el proxy
# activo el challenge puede no llegar a Caddy. Si una renovación falla:
# nube gris unos minutos, Caddy renueva, y se vuelve a naranja.

{
	email {$EMAIL_TLS}
}

{$DOMINIO} {
	encode gzip

	# La API. handle_path quita el prefijo /api antes de pasar la petición:
	# /api/auth/login llega a FastAPI como /auth/login.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# Docs de FastAPI, útiles en la sustentación
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# El frontend Angular como estático, con fallback a index.html
	# para que el enrutamiento del lado del cliente funcione
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

# Si alguien escribe www, lo mandamos al dominio sin www: una sola URL.
# Requiere también un registro para www en Cloudflare (CNAME al dominio).
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

n8n.{$DOMINIO} {
	reverse_proxy n8n:5678
}
